# Copy to .env for local development. Never upload this file with credentials.
# Cloudflare Pages: configure Variables and Secrets separately.
SQUARE_ENVIRONMENT=production
SQUARE_API_VERSION=2026-09-16
SQUARE_LOCATION_ID=
# Secret: Square server access token. No Application ID/payment SDK is required.
SQUARE_ACCESS_TOKEN=

# true creates REAL appointments in Production. Use false for Preview.
# Online payment is disabled in code regardless of this flag.
BOOKING_ENABLED=false
# Secret: preserve the existing 32+ character encryption/recovery key.
# The legacy name is intentional so existing D1 records remain readable.
CHECKOUT_RECOVERY_SECRET=
BOOKING_ALLOWED_ORIGINS=https://waterloobarber.shop

# Secret: Square > Production > Webhooks > Subscriptions > endpoint > Signature Key.
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=https://waterloobarber.shop/api/booking/webhook
# Required events: booking.created, booking.updated. payment.updated is ignored.
BOOKING_DEMO_PORT=3000

# CHECKOUT_DB is a D1 resource binding; do not add it as a text env variable.
# Run cloudflare/checkout-schema.sql in D1 Console. Apply cloudflare/migrations/0001-booking-holds.sql for the 10-minute hold upgrade.
# Legacy CHECKOUT_ENABLED is a fallback only when BOOKING_ENABLED is unset.
# SQUARE_APPLICATION_ID, Sandbox payment credentials and Apple/Google Pay are unused.
# Full logic, first installation and recovery: PROJECT_GUIDE.md.
