{
  "name": "the-barber-shop",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "next dev",
    "book": "pnpm run build:static && pnpm run book:serve",
    "book:serve": "node --env-file=.env scripts/booking-server.mjs",
    "demo": "pnpm run book",
    "demo:serve": "pnpm run book:serve",
    "test:booking": "node --test tests/booking-api.test.mjs tests/reservations.test.mjs tests/holds.test.mjs tests/booking-summary.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build-static.mjs",
    "build:website": "node scripts/build-static.mjs --assets-only",
    "audit:build": "node scripts/audit-build.mjs",
    "test:cloudflare": "node --test tests/cloudflare.test.mjs tests/build-security.test.mjs tests/env-config.test.mjs",
    "test:cloudflare-runtime": "node scripts/test-cloudflare-runtime.mjs",
    "start": "pnpm run book:serve",
    "build:static": "pnpm run build",
    "release:zip": "node scripts/release.mjs",
    "env:init": "node scripts/init-booking-env.mjs",
    "env:check": "node scripts/check-booking-env.mjs",
    "serve": "pnpm run book:serve"
  },
  "dependencies": {
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.546.0",
    "next": "15.5.6",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.156.0"
  }
}
